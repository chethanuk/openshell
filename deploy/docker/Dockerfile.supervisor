# The dynamically linked GNU supervisor binary is staged under
# deploy/docker/.build/prebuilt-binaries/<arch>/.

# Keep the GNU runtime and CA roots without a shell or unused native TLS libraries.
# Compute drivers override the image's non-root default with the runtime identity.
ARG SUPERVISOR_BASE_IMAGE=gcr.io/distroless/base-nossl-debian13@sha256:f21fdfe4ede467d9ea8a6caaec1f8381ea4502243a3e8bb1c43df80c6fbaaeae
FROM ${SUPERVISOR_BASE_IMAGE} AS supervisor

ARG TARGETARCH

COPY --chmod=0555 deploy/docker/.build/prebuilt-binaries/${TARGETARCH}/openshell-supervisor /openshell-supervisor

USER 65534:65534

HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD ["/openshell-supervisor", "health", "--socket", "/run/openshell/health.sock"]

ENTRYPOINT ["/openshell-supervisor"]
